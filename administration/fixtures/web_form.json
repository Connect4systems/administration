  "custom_css": "@import url(\"/assets/administration/css/job_application.css\");",
  "client_script": "const detailFields = {\n    custom_has_criminal_record: \"custom_criminal_record_details\",\n    custom_has_non_disclosure_or_non_compete: \"custom_non_disclosure_details\"\n};\nfunction updateDetailVisibility(checkbox, value) {\n    frappe.web_form.set_df_property(detailFields[checkbox], \"hidden\", Number(value) !== 1);\n}\nObject.keys(detailFields).forEach((checkbox) => {\n    frappe.web_form.on(checkbox, (field, value) => updateDetailVisibility(checkbox, value));\n});\nfrappe.web_form.after_load = () => {\n    Object.keys(detailFields).forEach((checkbox) => {\n        updateDetailVisibility(checkbox, frappe.web_form.get_value(checkbox));\n    });\n};\nconst applicationUploads = {\n    custom_photo: [\".png\", \".jpg\", \".jpeg\", \".gif\"],\n    resume_attachment: [\".pdf\", \".doc\", \".docx\"]\n};\nObject.entries(applicationUploads).forEach(([fieldname, extensions]) => {\n    const field = frappe.web_form.get_field(fieldname);\n    field.on_attach_click = () => {\n        const input = document.createElement(\"input\");\n        input.type = \"file\";\n        input.accept = extensions.join(\",\");\n        input.onchange = async () => {\n            const file = input.files[0];\n            if (!file) return;\n            const extension = \".\" + file.name.split(\".\").pop().toLowerCase();\n            if (!extensions.includes(extension)) {\n                frappe.msgprint(__(\"Allowed file formats: {0}\", [extensions.join(\", \")]));\n                return;\n            }\n            const data = new FormData();\n            data.append(\"file\", file);\n            data.append(\"fieldname\", fieldname);\n            field.$input.prop(\"disabled\", true);\n            try {\n                const response = await fetch(\"/api/method/administration.job_application.upload_application_file\", {\n                    method: \"POST\",\n                    headers: {\"X-Frappe-CSRF-Token\": frappe.csrf_token || \"\"},\n                    body: data\n                });\n                const result = await response.json();\n                if (!response.ok || !result.message?.file_url) {\n                    let message = __(\"Upload failed. Please check the file format and size and try again.\");\n                    if (result._server_messages) {\n                        const messages = JSON.parse(result._server_messages);\n                        message = messages.map((item) => JSON.parse(item).message).join(\"<br>\");\n                    }\n                    frappe.msgprint(message);\n                    return;\n                }\n                await field.on_upload_complete(result.message);\n            } catch (error) {\n                frappe.msgprint(__(\"Upload failed. Please try again.\"));\n            } finally {\n                field.$input.prop(\"disabled\", false);\n            }\n        };\n        input.click();\n    };\n});\n"
 }
